[Unit]
Description=AegisX reverse proxy
Documentation=https://github.com/comstrx/aegisx
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=aegisx
Group=aegisx
ExecStartPre=/usr/local/bin/aegisx --config /etc/aegisx/Aegisx.lua --check
ExecStart=/usr/local/bin/aegisx --config /etc/aegisx/Aegisx.lua
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=1
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=aegisx
LogsDirectory=aegisx
EnvironmentFile=-/etc/aegisx/aegisx.env

[Install]
WantedBy=multi-user.target
